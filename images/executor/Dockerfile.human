FROM python:3.11-slim

# Tools: bash, git, curl, coreutils, plus Go (needed for GO1, CROSS1, and
# any future Go-flavored tasks). Node is installed for JS2/XSS tasks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git curl ca-certificates coreutils findutils \
    build-essential procps jq \
    nodejs npm \
 && rm -rf /var/lib/apt/lists/*

# Go 1.22 — apt's golang is too old on slim. Install the upstream tarball.
RUN curl -fsSL https://go.dev/dl/go1.22.5.linux-amd64.tar.gz \
      -o /tmp/go.tgz \
 && tar -xzf /tmp/go.tgz -C /usr/local \
 && rm /tmp/go.tgz \
 && ln -s /usr/local/go/bin/go /usr/local/bin/go \
 && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt

# Pre-install the common Python test dependencies so per-session setup.sh
# scripts are fast (most only pip-install packages that are already here).
RUN pip install --no-cache-dir \
      pytest==8.3.3 pytest-flask==1.3.0 pytest-timeout==2.3.1 \
      hypothesis==6.112.0 pytest-cov==5.0.0 \
      flask==3.0.3 requests==2.32.3 pydantic==2.9.2 \
      numpy==1.26.4 pandas==2.2.3 scipy==1.13.1 scikit-learn==1.5.2 \
      pyyaml==6.0.2 \
      cryptography==43.0.1 pycryptodome==3.21.0 pyjwt==2.9.0 \
      redis==5.1.1 sqlalchemy==2.0.35 \
      statsmodels==0.14.4 imbalanced-learn==0.12.4

WORKDIR /
RUN useradd -m -u 10001 agent
# Allow agent to write to /usr/local/lib for pip during setup.sh (for tasks
# that need extra deps); simpler than alternating root/agent.
RUN chmod -R a+rwx /usr/local/lib/python3.11/site-packages
USER agent
