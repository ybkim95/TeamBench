diff --git a/changelog/3764.bugfix.rst b/changelog/3764.bugfix.rst
new file mode 100644
index 0000000000..50d155ad8a
--- /dev/null
+++ b/changelog/3764.bugfix.rst
@@ -0,0 +1 @@
+Fixed ``BaseHTTPResponse.readinto()`` type annotation to accept ``memoryview`` in addition to ``bytearray``, matching the ``io.RawIOBase.readinto`` contract and enabling use with ``io.BufferedReader`` without type errors.
diff --git a/src/urllib3/response.py b/src/urllib3/response.py
index ff6d1f4911..655fafd7f8 100644
--- a/src/urllib3/response.py
+++ b/src/urllib3/response.py
@@ -663,7 +663,7 @@ def _flush_decoder(self) -> bytes:
         return b""
 
     # Compatibility methods for `io` module
-    def readinto(self, b: bytearray) -> int:
+    def readinto(self, b: bytearray | memoryview[int]) -> int:
         temp = self.read(len(b))
         if len(temp) == 0:
             return 0
