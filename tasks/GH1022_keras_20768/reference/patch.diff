+            return coords, tf.ones_like(coords, dtype=tf.bool)
+        elif fill_mode == "wrap":
+            coords = tf.math.mod(coords, size)
+            return coords, tf.ones_like(coords, dtype=tf.bool)
+        else:
+            raise ValueError(f"Unknown fill_mode: {fill_mode}")
