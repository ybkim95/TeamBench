 def is_fully_escaped(s: str) -> bool:
     # we know we won't compile with re.VERBOSE, so whitespace doesn't need to be escaped
-    metacharacters = "{}()+.*?^$[]"
+    metacharacters = "{}()+.*?^$[]|"
     return not any(
         c in metacharacters and (i == 0 or s[i - 1] != "\\") for (i, c) in enumerate(s)
     )
 
 
